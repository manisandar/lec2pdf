# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Photo files — do NOT commit these (they are personal lecture photos)
# Exception: assets/ folder is allowed (contains demo images for README)
*.heic
*.HEIC
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.PNG
!assets/
!assets/*.jpg
!assets/*.png

# Output PDF files — do NOT commit these (they are generated output)
*.pdf
*.PDF

# Temporary files created by the script
slides_pdf_*/

# Editor / IDE files
.vscode/
.idea/
*.swp
*.swo

# Python virtual environments
venv/
.venv/
env/
